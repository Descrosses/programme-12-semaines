---
/**
 * Mise en page commune à toutes les pages :
 * balises SEO (title, description, Open Graph), en-tête, bandeau santé, pied de page.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HealthBanner from '../components/HealthBanner.astro';
import { SITE } from '../config';

interface Props {
  titre: string;            // titre de la page (onglet + Google)
  description?: string;     // résumé pour Google et les réseaux sociaux
  image?: string;           // image de partage (sinon /og-image.png)
  noindex?: boolean;        // true = page exclue de Google (pages de remerciement)
}
const { titre, description = SITE.description, image = '/og-image.png', noindex = false } = Astro.props;

const titreComplet = titre === SITE.nom ? titre : `${titre} | ${SITE.nom}`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0d1014" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph : aperçu quand le lien est partagé (WhatsApp, Facebook, LinkedIn…) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={urlImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-accent focus:p-3 focus:text-sur-accent">
      Aller au contenu
    </a>
    <HealthBanner />
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
